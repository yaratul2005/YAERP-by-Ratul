<UserControl x:Class="YAERP.UI.Controls.DrawerHost"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:controls="clr-namespace:YAERP.UI.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800">

    <Grid Visibility="{Binding IsOpen, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}">
        <!-- Dimmed Backdrop -->
        <Border Background="#800F172A">
            <Border.InputBindings>
                <MouseBinding MouseAction="LeftClick" Command="{Binding CloseCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
            </Border.InputBindings>
        </Border>

        <!-- Slide-Out Drawer Panel -->
        <Border Width="480" HorizontalAlignment="Right" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1,0,0,0">
            <Border.Effect>
                <DropShadowEffect Color="#0F172A" Direction="180" ShadowDepth="12" BlurRadius="32" Opacity="0.25"/>
            </Border.Effect>
            <Border.RenderTransform>
                <TranslateTransform x:Name="DrawerTranslateTransform" X="0"/>
            </Border.RenderTransform>

            <Grid Margin="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Drawer Header -->
                <DockPanel Grid.Row="0" Margin="0,0,0,20">
                    <Button DockPanel.Dock="Right" Command="{Binding CloseCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="6">
                        <controls:SvgIcon Data="{StaticResource Svg.Close}" Width="16" Height="16" Foreground="#64748B"/>
                    </Button>

                    <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                               FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                </DockPanel>

                <!-- Drawer Body Content -->
                <ContentControl Grid.Row="1" Content="{Binding DrawerContent, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
