<UserControl x:Class="YAERP.UI.Views.Controls.CommandPaletteOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Background="#800F172A" Visibility="{Binding IsVisible, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}">
        <Border Width="650" MaxHeight="500" VerticalAlignment="Top" HorizontalAlignment="Center"
                Margin="0,100,0,0" Background="#FFFFFF" CornerRadius="12" Padding="0">
            <Border.Effect>
                <DropShadowEffect Color="#0F172A" Direction="270" ShadowDepth="12" BlurRadius="32" Opacity="0.2"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Search Input -->
                <Border Grid.Row="0" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="🔍" FontSize="18" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <TextBox x:Name="SearchInput" Grid.Column="1" FontSize="18" BorderThickness="0" Background="Transparent"
                                 Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                 PreviewKeyDown="SearchInput_PreviewKeyDown"/>

                        <!-- Placeholder -->
                        <TextBlock Grid.Column="1" Text="Type a command or search..." FontSize="18" Foreground="#CBD5E1"
                                   IsHitTestVisible="False" VerticalAlignment="Center"
                                   Visibility="{Binding Text.IsEmpty, ElementName=SearchInput, Converter={StaticResource BoolToVis}}"/>
                    </Grid>
                </Border>

                <!-- Results List -->
                <ListBox x:Name="ResultsList" Grid.Row="1" ItemsSource="{Binding SearchResults}" SelectedItem="{Binding SelectedCommand}"
                         BorderThickness="0" Background="Transparent" Margin="0,8" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         PreviewKeyDown="ResultsList_PreviewKeyDown" MouseDoubleClick="ResultsList_MouseDoubleClick">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="20,12"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#F1F5F9"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#F8FAFC"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="{Binding IconKey}" FontSize="20" VerticalAlignment="Center" Margin="0,0,16,0"/>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" Foreground="#0F172A"/>
                                    <TextBlock Text="{Binding Subtitle}" FontSize="12" Foreground="#64748B" Margin="0,2,0,0"/>
                                </StackPanel>

                                <Border Grid.Column="2" Background="#F1F5F9" CornerRadius="4" Padding="6,2" VerticalAlignment="Center"
                                        Visibility="{Binding Category, Converter={StaticResource StringToVisConverter}}">
                                    <TextBlock Text="{Binding Category}" FontSize="11" FontWeight="SemiBold" Foreground="#475569"/>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Footer -->
                <Border Grid.Row="2" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="20,12" CornerRadius="0,0,12,12">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="↑↓" FontWeight="Bold" Foreground="#64748B" Margin="0,0,4,0"/>
                        <TextBlock Text="to navigate" Foreground="#94A3B8" Margin="0,0,16,0"/>

                        <TextBlock Text="↵" FontWeight="Bold" Foreground="#64748B" Margin="0,0,4,0"/>
                        <TextBlock Text="to select" Foreground="#94A3B8" Margin="0,0,16,0"/>

                        <TextBlock Text="ESC" FontWeight="Bold" Foreground="#64748B" Margin="0,0,4,0"/>
                        <TextBlock Text="to close" Foreground="#94A3B8"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
