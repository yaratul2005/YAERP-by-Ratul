<UserControl x:Class="YAERP.UI.Views.FinanceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BackgroundCanvasBrush}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
    </UserControl.Resources>

    <Grid Margin="10">
        <DockPanel>
            <!-- Header Toolbar -->
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Left">
                        <TextBlock Text="General Ledger &amp; Chart of Accounts" FontSize="26" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock Text="Double-entry bookkeeping accounts, journal entries, and AI ledger anomaly audit" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Content="🔍  Run AI Audit" Command="{Binding LoadFinancialAnomaliesCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0"/>
                        <Button Content="💰  Load Financial Data" Command="{Binding LoadFinanceDataCommand}" Style="{StaticResource PrimaryButton}"/>
                    </StackPanel>
                </DockPanel>
            </StackPanel>

            <!-- AI Ledger Audit Alert Banner -->
            <Border DockPanel.Dock="Top" Background="#FEF2F2" BorderBrush="#FCA5A5" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,16"
                    Visibility="{Binding HasAnomalies, Converter={StaticResource BoolToVisConverter}}">
                <DockPanel>
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                        <Border Background="#EF4444" CornerRadius="12" Width="24" Height="24" Margin="0,0,10,0">
                            <TextBlock Text="!" Foreground="#FFFFFF" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel>
                            <TextBlock Text="AI Ledger Audit Warning" FontSize="14" FontWeight="Bold" Foreground="#991B1B"/>
                            <TextBlock Text="{Binding AnomalyCount, StringFormat='{}{0} Statistical ledger anomalies detected (|Z| &gt; 3.0 spikes or near-duplicate postings within 5 mins).'}" FontSize="12" Foreground="#7F1D1D" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>
                    <Button Content="Re-Audit" Command="{Binding LoadFinancialAnomaliesCommand}" HorizontalAlignment="Right" VerticalAlignment="Center"
                            Padding="10,4" Background="#991B1B" Foreground="#FFFFFF" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
                </DockPanel>
            </Border>

            <!-- Main Layout: Grid of Accounts, Journal Entries, and Flagged Anomalies -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- AI Flagged Anomalies DataGrid Section -->
                <Border Style="{StaticResource ModernCard}" Grid.Row="0" Margin="0,0,0,14" Padding="0"
                        Visibility="{Binding HasAnomalies, Converter={StaticResource BoolToVisConverter}}">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Background="#FEF2F2" Padding="16,10" BorderBrush="#FCA5A5" BorderThickness="0,0,0,1">
                            <DockPanel>
                                <TextBlock Text="⚠️  Flagged Financial Anomalies (Z-Score &amp; Duplicate Postings)" FontSize="14" FontWeight="Bold" Foreground="#991B1B"/>
                                <TextBlock Text="{Binding AnomalyCount, StringFormat='Count: {0}'}" FontSize="12" FontWeight="Bold" Foreground="#B91C1C" HorizontalAlignment="Right"/>
                            </DockPanel>
                        </Border>
                        <DataGrid ItemsSource="{Binding FlaggedAnomalies}" Style="{StaticResource ModernDataGrid}" MaxHeight="160">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Entry #" Binding="{Binding EntryNumber}" Width="100"/>
                                <DataGridTextColumn Header="Account" Binding="{Binding AccountName}" Width="140"/>
                                <DataGridTextColumn Header="Amount ($)" Binding="{Binding Amount, StringFormat='{}{0:C2}'}" Width="120"/>
                                <DataGridTemplateColumn Header="Anomaly Type" Width="150">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="#FEE2E2" CornerRadius="12" Padding="8,3" HorizontalAlignment="Left">
                                                <TextBlock Text="{Binding ZScore, StringFormat='Spike Z-Score: {0:F2}'}" Foreground="#991B1B" FontSize="11" FontWeight="Bold"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Audit Risk Description" Binding="{Binding AnomalyReason}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>

                <!-- Chart of Accounts Card -->
                <Border Style="{StaticResource ModernCard}" Grid.Row="1" Margin="0,0,0,14" Padding="0">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Background="#F1F5F9" Padding="16,10" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,0,1">
                            <TextBlock Text="Chart of Accounts" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                        </Border>
                        <DataGrid ItemsSource="{Binding Accounts}" Style="{StaticResource ModernDataGrid}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Account #" Binding="{Binding AccountNumber}" Width="140"/>
                                <DataGridTextColumn Header="Account Name" Binding="{Binding Name}" Width="*"/>
                                <DataGridTextColumn Header="Current Balance ($)" Binding="{Binding Balance, StringFormat='{}{0:C2}'}" Width="180"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>

                <!-- Journal Entries Card -->
                <Border Style="{StaticResource ModernCard}" Grid.Row="2" Padding="0">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Background="#F1F5F9" Padding="16,10" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,0,1">
                            <TextBlock Text="Recent Journal Entries" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                        </Border>
                        <DataGrid ItemsSource="{Binding JournalEntries}" Style="{StaticResource ModernDataGrid}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Entry #" Binding="{Binding EntryNumber}" Width="140"/>
                                <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/>
                                <DataGridTemplateColumn Header="Posting Status" Width="160">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="#DCFCE7" CornerRadius="12" Padding="10,4" HorizontalAlignment="Left">
                                                <TextBlock Text="● Posted" Foreground="#15803D" FontSize="11" FontWeight="Bold"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>
            </Grid>
        </DockPanel>
    </Grid>
</UserControl>
