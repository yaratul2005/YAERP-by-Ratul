<UserControl x:Class="YAERP.UI.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BackgroundCanvasBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header Bar -->
            <DockPanel Grid.Row="0" Margin="0,0,0,24">
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="Executive Performance Dashboard" FontSize="26" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="Real-time financial velocity, stock allocation, and ML.NET AI operational health" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                </StackPanel>
                <Button Content="🔄  Refresh Analytics" Command="{Binding LoadMetricsCommand}" 
                        Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </DockPanel>

            <!-- AI Operational Health Summary Widget Banner -->
            <Border Grid.Row="1" Background="#F0FDF4" BorderBrush="#86EFAC" BorderThickness="1" CornerRadius="10" Padding="16,12" Margin="0,0,0,24">
                <DockPanel>
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                        <Border Background="#10B981" Width="36" Height="36" CornerRadius="8" Margin="0,0,14,0">
                            <TextBlock Text="🤖" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel>
                            <TextBlock Text="ML.NET AI Operational Health Engine Active" FontSize="15" FontWeight="Bold" Foreground="#065F46"/>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <TextBlock Text="{Binding AiStockoutRiskCount, StringFormat='Stockout Risks: {0} SKUs Flagged'}" Foreground="#991B1B" FontWeight="Bold" FontSize="12" Margin="0,0,16,0"/>
                                <TextBlock Text="|" Foreground="#A7F3D0" Margin="0,0,16,0"/>
                                <TextBlock Text="{Binding AiLedgerAnomalyCount, StringFormat='Ledger Anomalies: {0} Entries Flagged'}" Foreground="#92400E" FontWeight="Bold" FontSize="12"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Content="Inspect Stockout Risks →" Command="{Binding NavigateToInventoryCommand}" 
                                Padding="10,6" Background="#065F46" Foreground="#FFFFFF" FontWeight="Bold" FontSize="11" BorderThickness="0" Margin="0,0,8,0" Cursor="Hand"/>
                        <Button Content="Audit Ledger Anomalies →" Command="{Binding NavigateToFinanceCommand}" 
                                Padding="10,6" Background="#D97706" Foreground="#FFFFFF" FontWeight="Bold" FontSize="11" BorderThickness="0" Cursor="Hand"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Interactive KPI Metric Cards -->
            <UniformGrid Grid.Row="2" Columns="3" Margin="0,0,0,24">
                <!-- Sales Orders Card -->
                <Border Style="{StaticResource ModernCard}" Margin="0,0,12,0">
                    <DockPanel>
                        <Border Width="48" Height="48" CornerRadius="10" Background="#EFF6FF" DockPanel.Dock="Right" VerticalAlignment="Top">
                            <TextBlock Text="📈" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel>
                            <TextBlock Text="Total Sales Velocity" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding TotalSales, StringFormat='{}{0:N0}'}" FontSize="32" FontWeight="Bold" Foreground="#0284C7" Margin="0,6,0,0"/>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <Border Background="#DCFCE7" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                    <TextBlock Text="▲ +14.2%" Foreground="#15803D" FontSize="11" FontWeight="Bold"/>
                                </Border>
                                <TextBlock Text="vs previous 30 days" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Stock Items Card -->
                <Border Style="{StaticResource ModernCard}" Margin="6,0,6,0">
                    <DockPanel>
                        <Border Width="48" Height="48" CornerRadius="10" Background="#F0FDF4" DockPanel.Dock="Right" VerticalAlignment="Top">
                            <TextBlock Text="📦" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel>
                            <TextBlock Text="Inventory Items (SKUs)" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding StockCount, StringFormat='{}{0:N0}'}" FontSize="32" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,6,0,0"/>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <Border Background="#FEF3C7" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                    <TextBlock Text="● Healthy Stock" Foreground="#B45309" FontSize="11" FontWeight="Bold"/>
                                </Border>
                                <TextBlock Text="across 4 warehouses" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Active Invoices Card -->
                <Border Style="{StaticResource ModernCard}" Margin="12,0,0,0">
                    <DockPanel>
                        <Border Width="48" Height="48" CornerRadius="10" Background="#FEF3C7" DockPanel.Dock="Right" VerticalAlignment="Top">
                            <TextBlock Text="💰" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel>
                            <TextBlock Text="Active Outstanding Invoices" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding ActiveInvoices, StringFormat='{}{0:N0}'}" FontSize="32" FontWeight="Bold" Foreground="#D97706" Margin="0,6,0,0"/>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <Border Background="#E0F2FE" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                    <TextBlock Text="⚡ 94% Collection Rate" Foreground="#0369A1" FontSize="11" FontWeight="Bold"/>
                                </Border>
                                <TextBlock Text="within terms" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </DockPanel>
                </Border>
            </UniformGrid>

            <!-- Visual Charts Analytics Grid -->
            <Grid Grid.Row="3" Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="1.2*"/>
                </Grid.ColumnDefinitions>

                <!-- Revenue Velocity Trend Line Chart -->
                <Border Style="{StaticResource ModernCard}" Grid.Column="0" Margin="0,0,12,0">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,16">
                            <StackPanel DockPanel.Dock="Left">
                                <TextBlock Text="12-Month Revenue Velocity ($ Total)" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="Monthly sales performance trend curve" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                            <TextBlock Text="Current FY 2026" Foreground="#0284C7" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                        </DockPanel>

                        <!-- WPF Polygon Area + Polyline Chart Canvas -->
                        <Grid Height="200" Background="#FAFAFA" Margin="0,8,0,12">
                            <!-- Area Gradient Fill -->
                            <Polygon Points="0,200 0,140 60,120 120,150 180,110 240,90 300,105 360,60 420,75 480,40 540,55 600,20 600,200" Fill="#200284C7"/>
                            <!-- Trend Line Curve -->
                            <Polyline Points="0,140 60,120 120,150 180,110 240,90 300,105 360,60 420,75 480,40 540,55 600,20" 
                                      Stroke="#0284C7" StrokeThickness="3" StrokeLineJoin="Round"/>
                        </Grid>

                        <!-- Chart X-Axis Labels -->
                        <UniformGrid Columns="12">
                            <TextBlock Text="Jan" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Text="Feb" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Text="Mar" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Text="Apr" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Text="May" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Text="Jun" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Text="Jul" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Text="Aug" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Text="Sep" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Text="Oct" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Text="Nov" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Text="Dec" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <!-- Warehouse Stock Allocation Bar Chart -->
                <Border Style="{StaticResource ModernCard}" Grid.Column="1">
                    <StackPanel>
                        <TextBlock Text="Warehouse Allocation" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,16"/>

                        <!-- Bar 1: Main Warehouse -->
                        <StackPanel Margin="0,0,0,14">
                            <DockPanel Margin="0,0,0,4">
                                <TextBlock Text="Main Warehouse" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="4,200 Units (65%)" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Right"/>
                            </DockPanel>
                            <Border Height="10" Background="#F1F5F9" CornerRadius="5">
                                <Border HorizontalAlignment="Left" Width="200" Background="#0284C7" CornerRadius="5"/>
                            </Border>
                        </StackPanel>

                        <!-- Bar 2: West Coast Hub -->
                        <StackPanel Margin="0,0,0,14">
                            <DockPanel Margin="0,0,0,4">
                                <TextBlock Text="West Coast Hub" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="1,850 Units (25%)" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Right"/>
                            </DockPanel>
                            <Border Height="10" Background="#F1F5F9" CornerRadius="5">
                                <Border HorizontalAlignment="Left" Width="110" Background="#10B981" CornerRadius="5"/>
                            </Border>
                        </StackPanel>

                        <!-- Bar 3: Central Logistics -->
                        <StackPanel Margin="0,0,0,14">
                            <DockPanel Margin="0,0,0,4">
                                <TextBlock Text="Central Logistics" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="650 Units (10%)" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Right"/>
                            </DockPanel>
                            <Border Height="10" Background="#F1F5F9" CornerRadius="5">
                                <Border HorizontalAlignment="Left" Width="55" Background="#F59E0B" CornerRadius="5"/>
                            </Border>
                        </StackPanel>

                        <!-- Invoice Aging Legend -->
                        <Border Background="#F8FAFC" CornerRadius="8" Padding="12" Margin="0,8,0,0" BorderBrush="#E2E8F0" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Invoice Collection Aging" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                                <DockPanel Margin="0,2">
                                    <TextBlock Text="● Current (0-30 Days)" Foreground="#10B981" FontSize="11" FontWeight="SemiBold"/>
                                    <TextBlock Text="88%" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" HorizontalAlignment="Right"/>
                                </DockPanel>
                                <DockPanel Margin="0,2">
                                    <TextBlock Text="● Pending (31-60 Days)" Foreground="#F59E0B" FontSize="11" FontWeight="SemiBold"/>
                                    <TextBlock Text="9%" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" HorizontalAlignment="Right"/>
                                </DockPanel>
                                <DockPanel Margin="0,2">
                                    <TextBlock Text="● Overdue (&gt;60 Days)" Foreground="#EF4444" FontSize="11" FontWeight="SemiBold"/>
                                    <TextBlock Text="3%" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" HorizontalAlignment="Right"/>
                                </DockPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
