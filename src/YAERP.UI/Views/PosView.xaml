<UserControl x:Class="YAERP.UI.Views.PosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BackgroundCanvasBrush}"
             PreviewKeyDown="UserControl_PreviewKeyDown">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid Margin="10">
        <DockPanel>
            <!-- Header Bar -->
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Left">
                        <TextBlock Text="Express POS Terminal &amp; Hardware Checkout" FontSize="26" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock Text="Touch-optimized register, barcode HID scanner listener, thermal receipt ESC/POS printer, &amp; cash drawer interop" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Border Background="#EFF6FF" BorderBrush="#93C5FD" BorderThickness="1" CornerRadius="8" Padding="10,6" Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🖨️  Printer: " FontSize="12" Foreground="#1E40AF" FontWeight="SemiBold"/>
                                <ComboBox SelectedValue="{Binding SelectedPrinterName}" SelectedValuePath="Content" Width="100" Padding="4,2">
                                    <ComboBoxItem Content="MOCK"/>
                                    <ComboBoxItem Content="POS-80"/>
                                    <ComboBoxItem Content="Epson-TM-T20"/>
                                </ComboBox>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </DockPanel>

                <!-- System Status Banner -->
                <Border Background="#F8FAFC" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,12,0,0"
                        Visibility="{Binding StatusMessage, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding StatusMessage}" FontSize="13" FontWeight="Bold" Foreground="#2563EB"/>
                </Border>
            </StackPanel>

            <!-- Main Layout: 2 Columns (Left Catalog, Right Checkout Terminal) -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.2*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left Pane: Product Catalog & Barcode Search -->
                <Border Style="{StaticResource ModernCard}" Grid.Column="0" Margin="0,0,12,0" Padding="16">
                    <DockPanel>
                        <!-- Search & Category Filters -->
                        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
                            <DockPanel Margin="0,0,0,12">
                                <TextBlock Text="🔍  Scan / Search Product SKU:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,10,0"/>
                                <TextBox Text="{Binding SearchBarcodeQuery, UpdateSourceTrigger=PropertyChanged}" Padding="10,8" FontSize="14" Background="#F1F5F9" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1"/>
                            </DockPanel>
                        </StackPanel>

                        <!-- Product Catalog DataGrid -->
                        <DataGrid ItemsSource="{Binding CatalogProducts}" SelectedItem="{Binding SelectedCatalogProduct}" Style="{StaticResource ModernDataGrid}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="SKU Code" Binding="{Binding SKU}" Width="110"/>
                                <DataGridTextColumn Header="Product Name" Binding="{Binding Name}" Width="*"/>
                                <DataGridTextColumn Header="Price ($)" Binding="{Binding Price, StringFormat='{}{0:C2}'}" Width="100"/>
                                <DataGridTextColumn Header="Stock" Binding="{Binding Stock, StringFormat='{}{0:N0}'}" Width="80"/>
                                <DataGridTemplateColumn Header="Action" Width="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="➕ Add to Cart" Command="{Binding DataContext.AddToCartCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                    CommandParameter="{Binding}" Padding="8,6" MinHeight="36" FontSize="12" FontWeight="Bold" 
                                                    Background="#2563EB" Foreground="#FFFFFF" BorderThickness="0" Cursor="Hand"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>

                <!-- Right Pane: Active Cart & Register Terminal -->
                <Border Style="{StaticResource ModernCard}" Grid.Column="1" Padding="16">
                    <DockPanel>
                        <!-- Cart Header -->
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                            <TextBlock Text="🛒 Current Active Cart" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <Button Content="🗑️ Clear Cart" Command="{Binding ClearCartCommand}" HorizontalAlignment="Right" 
                                    Padding="8,4" Background="#FEF2F2" Foreground="#991B1B" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
                        </DockPanel>

                        <!-- Checkout & Payment Summary Controls -->
                        <StackPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
                            <!-- Totals Box -->
                            <Border Background="#F8FAFC" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,14">
                                <StackPanel>
                                    <DockPanel Margin="0,2">
                                        <TextBlock Text="Subtotal:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13"/>
                                        <TextBlock Text="{Binding SubTotal, StringFormat='{}{0:C2}'}" FontWeight="Bold" FontSize="13" HorizontalAlignment="Right"/>
                                    </DockPanel>
                                    <DockPanel Margin="0,2">
                                        <TextBlock Text="Sales Tax (10% VAT):" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13"/>
                                        <TextBlock Text="{Binding TaxAmount, StringFormat='{}{0:C2}'}" FontWeight="Bold" FontSize="13" HorizontalAlignment="Right"/>
                                    </DockPanel>
                                    <Separator Background="{StaticResource BorderSubtleBrush}" Margin="0,6"/>
                                    <DockPanel Margin="0,2">
                                        <TextBlock Text="GRAND TOTAL:" Foreground="{StaticResource TextPrimaryBrush}" FontSize="18" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding GrandTotal, StringFormat='{}{0:C2}'}" Foreground="#2563EB" FontSize="22" FontWeight="Bold" HorizontalAlignment="Right"/>
                                    </DockPanel>
                                </StackPanel>
                            </Border>

                            <!-- Payment Method & Tendered Controls -->
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                    <TextBlock Text="Payment Method:" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                    <ComboBox SelectedValue="{Binding SelectedPaymentMethod}" SelectedValuePath="Content" Padding="8,6">
                                        <ComboBoxItem Content="Cash"/>
                                        <ComboBoxItem Content="Credit Card"/>
                                        <ComboBoxItem Content="QR Code"/>
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                    <TextBlock Text="Cash Tendered ($):" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding CashTendered, StringFormat='{}{0:F2}', UpdateSourceTrigger=PropertyChanged}" Padding="8,6" FontWeight="Bold" Background="#F1F5F9"/>
                                </StackPanel>
                            </Grid>

                            <!-- Change Due Callout -->
                            <Border Background="#F0FDF4" BorderBrush="#86EFAC" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,14">
                                <DockPanel>
                                    <TextBlock Text="Change Due:" FontSize="13" FontWeight="Bold" Foreground="#065F46"/>
                                    <TextBlock Text="{Binding ChangeDue, StringFormat='{}{0:C2}'}" FontSize="16" FontWeight="Bold" Foreground="#047857" HorizontalAlignment="Right"/>
                                </DockPanel>
                            </Border>

                            <!-- Hardware Toggles -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                <CheckBox IsChecked="{Binding AutoPrintReceipt}" Content="🖨️ Auto-Print Receipt" Margin="0,0,16,0" VerticalAlignment="Center"/>
                                <CheckBox IsChecked="{Binding AutoOpenCashDrawer}" Content="💰 Kick Cash Drawer" VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- Big Checkout Button -->
                            <Button Command="{Binding CompleteTransactionCommand}" Height="52" Background="#10B981" Foreground="#FFFFFF" 
                                    FontSize="16" FontWeight="Bold" BorderThickness="0" Cursor="Hand">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="💳  PAY &amp; COMPLETE CHECKOUT (" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding GrandTotal, StringFormat='{}{0:C2}'}" VerticalAlignment="Center"/>
                                    <TextBlock Text=")" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <!-- Cart Items DataGrid -->
                        <DataGrid ItemsSource="{Binding CurrentCart}" Style="{StaticResource ModernDataGrid}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Item Name" Binding="{Binding Name}" Width="*"/>
                                <DataGridTemplateColumn Header="Qty" Width="100">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <Button Content="-" Command="{Binding DataContext.DecreaseQuantityCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Width="24" Height="24" Background="#E2E8F0" BorderThickness="0"/>
                                                <TextBlock Text="{Binding Quantity, StringFormat='{}{0:N0}'}" FontWeight="Bold" VerticalAlignment="Center" Margin="8,0"/>
                                                <Button Content="+" Command="{Binding DataContext.IncreaseQuantityCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Width="24" Height="24" Background="#E2E8F0" BorderThickness="0"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Price ($)" Binding="{Binding UnitPrice, StringFormat='{}{0:C2}'}" Width="80"/>
                                <DataGridTextColumn Header="Total ($)" Binding="{Binding LineTotal, StringFormat='{}{0:C2}'}" Width="90"/>
                                <DataGridTemplateColumn Header="Del" Width="50">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="✕" Command="{Binding DataContext.RemoveFromCartCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                    CommandParameter="{Binding}" Foreground="#991B1B" Background="Transparent" BorderThickness="0" Cursor="Hand"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>
            </Grid>
        </DockPanel>
    </Grid>
</UserControl>
