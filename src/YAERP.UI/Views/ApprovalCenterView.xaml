<UserControl x:Class="YAERP.UI.Views.ApprovalCenterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:YAERP.UI.Controls"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1200"
             Background="#F8FAFC">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Header & Vector Toolbar -->
        <DockPanel Grid.Row="0" Margin="0,0,0,24">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="Multi-Level Approval Authorization Center" FontSize="24" FontWeight="Bold" Foreground="#0F172A"/>
                <TextBlock Text="Tiered supervisor escalations, audit history timeline &amp; high-value sign-offs" FontSize="14" Foreground="#64748B"/>
            </StackPanel>

            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <!-- Pending Count Pill Badge -->
                <Border Background="#FEF3C7" BorderBrush="#F59E0B" BorderThickness="1" CornerRadius="8" Padding="12,6" Margin="0,0,12,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⏳ Pending Requests: " FontSize="13" FontWeight="Bold" Foreground="#92400E"/>
                        <TextBlock Text="{Binding TotalPendingCount}" FontSize="15" FontWeight="Bold" Foreground="#B45309"/>
                    </StackPanel>
                </Border>

                <!-- [SVG: Check] Approve Selected Button -->
                <Button Command="{Binding ApproveSelectedCommand}" Padding="14,8" Background="#10B981" Foreground="White" FontWeight="Bold" BorderThickness="0" Margin="0,0,8,0" Cursor="Hand">
                    <StackPanel Orientation="Horizontal">
                        <controls:SvgIcon Data="{StaticResource Svg.Check}" Width="16" Height="16" Foreground="White" Margin="0,0,6,0"/>
                        <TextBlock Text="Approve Step" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- [SVG: Close] Reject Selected Button -->
                <Button Command="{Binding OpenRejectionReasonModalCommand}" Padding="14,8" Background="#DC2626" Foreground="White" FontWeight="Bold" BorderThickness="0" Margin="0,0,8,0" Cursor="Hand">
                    <StackPanel Orientation="Horizontal">
                        <controls:SvgIcon Data="{StaticResource Svg.Close}" Width="16" Height="16" Foreground="White" Margin="0,0,6,0"/>
                        <TextBlock Text="Reject Step" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- [SVG: Refresh] Refresh Button -->
                <Button Command="{Binding LoadPendingRequestsCommand}" Padding="12,8" Background="#F1F5F9" Foreground="#475569" FontWeight="Bold" BorderThickness="0" Cursor="Hand">
                    <StackPanel Orientation="Horizontal">
                        <controls:SvgIcon Data="{StaticResource Svg.Refresh}" Width="16" Height="16" Foreground="#475569" Margin="0,0,6,0"/>
                        <TextBlock Text="Refresh" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </DockPanel>

        <!-- Main Layout: 2 Columns -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.3*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Table Pane -->
            <Border Grid.Column="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="16">
                <DockPanel>
                    <TextBlock Text="📋 Transactions Awaiting Sign-Off" DockPanel.Dock="Top" FontSize="16" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,12"/>
                    <DataGrid ItemsSource="{Binding PendingRequests}" SelectedItem="{Binding SelectedRequest}" AutoGenerateColumns="False" CanUserAddRows="False"
                               GridLinesVisibility="Horizontal" BorderBrush="#E2E8F0" HeadersVisibility="Column" RowHeight="42">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Type" Binding="{Binding EntityType}" Width="110" FontWeight="Bold"/>
                            <DataGridTextColumn Header="Entity ID" Binding="{Binding EntityId}" Width="110"/>
                            <DataGridTextColumn Header="Amount ($)" Binding="{Binding TransactionAmount, StringFormat=C2}" Width="120" FontWeight="Bold" Foreground="#2563EB"/>
                            <DataGridTemplateColumn Header="Approval Tier" Width="150">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="#EFF6FF" BorderBrush="#93C5FD" BorderThickness="1" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding CurrentApprovalLevel}" FontSize="11" FontWeight="Bold" Foreground="#1E40AF"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Requested By" Binding="{Binding RequestedByUserId}" Width="*"/>
                            <DataGridTemplateColumn Header="Inspect" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding DataContext.OpenApprovalInspectorDrawerCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Content="🔍 Details" Padding="8,3" Background="#F1F5F9" Foreground="#2563EB" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <!-- Right Request Details & Action Pane -->
            <Border Grid.Column="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="16">
                <DockPanel>
                    <TextBlock Text="🔍 Authorization Decision &amp; Audit Notes" DockPanel.Dock="Top" FontSize="16" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,14"/>

                    <StackPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
                        <TextBlock Text="Approver Notes / Justification:" FontSize="12" FontWeight="Bold" Foreground="#475569" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding DecisionComments, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="65" Padding="8" Margin="0,0,0,14"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0" Command="{Binding ApproveSelectedCommand}" Height="42" Background="#10B981" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand">
                                <StackPanel Orientation="Horizontal">
                                    <controls:SvgIcon Data="{StaticResource Svg.Check}" Width="16" Height="16" Foreground="White" Margin="0,0,6,0"/>
                                    <TextBlock Text="APPROVE STEP" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button Grid.Column="2" Command="{Binding OpenRejectionReasonModalCommand}" Height="42" Background="#DC2626" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand">
                                <StackPanel Orientation="Horizontal">
                                    <controls:SvgIcon Data="{StaticResource Svg.Close}" Width="16" Height="16" Foreground="White" Margin="0,0,6,0"/>
                                    <TextBlock Text="REJECT REQUEST" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>

                    <!-- Selected Request Card Summary -->
                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14">
                        <StackPanel>
                            <DockPanel Margin="0,4">
                                <TextBlock Text="Transaction Type:" Foreground="#64748B" FontSize="13"/>
                                <TextBlock Text="{Binding SelectedRequest.EntityType}" FontWeight="Bold" FontSize="13" HorizontalAlignment="Right"/>
                            </DockPanel>
                            <DockPanel Margin="0,4">
                                <TextBlock Text="Reference Entity ID:" Foreground="#64748B" FontSize="13"/>
                                <TextBlock Text="{Binding SelectedRequest.EntityId}" FontWeight="Bold" FontSize="13" HorizontalAlignment="Right"/>
                            </DockPanel>
                            <DockPanel Margin="0,4">
                                <TextBlock Text="Requested Amount:" Foreground="#64748B" FontSize="13"/>
                                <TextBlock Text="{Binding SelectedRequest.TransactionAmount, StringFormat=C2}" Foreground="#2563EB" FontWeight="Bold" FontSize="18" HorizontalAlignment="Right"/>
                            </DockPanel>
                            <Separator Background="#CBD5E1" Margin="0,8"/>
                            <DockPanel Margin="0,4">
                                <TextBlock Text="Required Tier Level:" Foreground="#64748B" FontSize="13"/>
                                <TextBlock Text="{Binding SelectedRequest.CurrentApprovalLevel}" Foreground="#D97706" FontWeight="Bold" FontSize="13" HorizontalAlignment="Right"/>
                            </DockPanel>
                            <DockPanel Margin="0,4">
                                <TextBlock Text="Requester User:" Foreground="#64748B" FontSize="13"/>
                                <TextBlock Text="{Binding SelectedRequest.RequestedByUserId}" FontWeight="Bold" FontSize="13" HorizontalAlignment="Right"/>
                            </DockPanel>
                        </StackPanel>
                    </Border>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
