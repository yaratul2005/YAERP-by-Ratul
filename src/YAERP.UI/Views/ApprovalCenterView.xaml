<UserControl x:Class="YAERP.UI.Views.ApprovalCenterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BackgroundCanvasBrush}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid Margin="10">
        <DockPanel>
            <!-- Header Bar -->
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Left">
                        <TextBlock Text="Multi-Level Approval Authorization Center" FontSize="26" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock Text="Review pending high-value transactions, supervisor tier escalations, and executive sign-offs" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Border Background="#FEF3C7" BorderBrush="#F59E0B" BorderThickness="1" CornerRadius="8" Padding="12,6" Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⏳ Pending Approvals: " FontSize="13" FontWeight="Bold" Foreground="#92400E"/>
                                <TextBlock Text="{Binding TotalPendingCount}" FontSize="15" FontWeight="Bold" Foreground="#B45309"/>
                            </StackPanel>
                        </Border>
                        <Button Content="🔄 Refresh" Command="{Binding LoadPendingRequestsCommand}" Padding="10,6" MinHeight="36" Background="#F1F5F9" Foreground="#1E293B" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
                    </StackPanel>
                </DockPanel>

                <!-- System Status Banner -->
                <Border Background="#F8FAFC" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,12,0,0"
                        Visibility="{Binding StatusMessage, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding StatusMessage}" FontSize="13" FontWeight="Bold" Foreground="#2563EB"/>
                </Border>
            </StackPanel>

            <!-- Main Layout: Split Screen Pane -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.3*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left Pane: Pending Requests Table -->
                <Border Style="{StaticResource ModernCard}" Grid.Column="0" Margin="0,0,12,0" Padding="16">
                    <DockPanel>
                        <TextBlock Text="📋 Transactions Awaiting Sign-Off" DockPanel.Dock="Top" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12"/>
                        <DataGrid ItemsSource="{Binding PendingRequests}" SelectedItem="{Binding SelectedRequest}" Style="{StaticResource ModernDataGrid}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Type" Binding="{Binding EntityType}" Width="110"/>
                                <DataGridTextColumn Header="Entity ID" Binding="{Binding EntityId}" Width="110"/>
                                <DataGridTextColumn Header="Amount ($)" Binding="{Binding TransactionAmount, StringFormat='{}{0:C2}'}" Width="120"/>
                                <DataGridTemplateColumn Header="Approval Tier" Width="150">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="#EFF6FF" BorderBrush="#93C5FD" BorderThickness="1" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left">
                                                <TextBlock Text="{Binding CurrentApprovalLevel}" FontSize="11" FontWeight="Bold" Foreground="#1E40AF"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Requested By" Binding="{Binding RequestedByUserId}" Width="*"/>
                                <DataGridTextColumn Header="Created (UTC)" Binding="{Binding CreatedAtUtc, StringFormat='{}{0:MM/dd HH:mm}'}" Width="110"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>

                <!-- Right Detail & Action Card -->
                <Border Style="{StaticResource ModernCard}" Grid.Column="1" Padding="16">
                    <DockPanel>
                        <TextBlock Text="🔍 Transaction Breakdown &amp; Action" DockPanel.Dock="Top" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,14"/>

                        <StackPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
                            <!-- Comments Box -->
                            <TextBlock Text="Approver Notes / Rejection Reason:" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                            <TextBox Text="{Binding DecisionComments, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="70" Padding="8" Margin="0,0,0,14" Background="#F1F5F9" BorderBrush="{StaticResource BorderSubtleBrush}"/>

                            <!-- Decision Action Buttons -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Button Command="{Binding ApproveCommand}" Grid.Column="0" Height="48" Margin="0,0,6,0" Background="#10B981" Foreground="#FFFFFF" 
                                        FontSize="15" FontWeight="Bold" BorderThickness="0" Cursor="Hand">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="✓  APPROVE STEP" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <Button Command="{Binding RejectCommand}" Grid.Column="1" Height="48" Margin="6,0,0,0" Background="#EF4444" Foreground="#FFFFFF" 
                                        FontSize="15" FontWeight="Bold" BorderThickness="0" Cursor="Hand">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="✕  REJECT REQUEST" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </StackPanel>

                        <!-- Selected Request Detail Summary -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <Border Background="#F8FAFC" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
                                    <StackPanel>
                                        <DockPanel Margin="0,4">
                                            <TextBlock Text="Transaction Type:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13"/>
                                            <TextBlock Text="{Binding SelectedRequest.EntityType}" FontWeight="Bold" FontSize="13" HorizontalAlignment="Right"/>
                                        </DockPanel>
                                        <DockPanel Margin="0,4">
                                            <TextBlock Text="Reference Entity ID:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13"/>
                                            <TextBlock Text="{Binding SelectedRequest.EntityId}" FontWeight="Bold" FontSize="13" HorizontalAlignment="Right"/>
                                        </DockPanel>
                                        <DockPanel Margin="0,4">
                                            <TextBlock Text="Requested Amount:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13"/>
                                            <TextBlock Text="{Binding SelectedRequest.TransactionAmount, StringFormat='{}{0:C2}'}" Foreground="#2563EB" FontWeight="Bold" FontSize="18" HorizontalAlignment="Right"/>
                                        </DockPanel>
                                        <Separator Background="{StaticResource BorderSubtleBrush}" Margin="0,8"/>
                                        <DockPanel Margin="0,4">
                                            <TextBlock Text="Required Tier Level:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13"/>
                                            <TextBlock Text="{Binding SelectedRequest.CurrentApprovalLevel}" Foreground="#D97706" FontWeight="Bold" FontSize="13" HorizontalAlignment="Right"/>
                                        </DockPanel>
                                        <DockPanel Margin="0,4">
                                            <TextBlock Text="Requester User:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13"/>
                                            <TextBlock Text="{Binding SelectedRequest.RequestedByUserId}" FontWeight="Bold" FontSize="13" HorizontalAlignment="Right"/>
                                        </DockPanel>
                                        <DockPanel Margin="0,4">
                                            <TextBlock Text="Submission Timestamp:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13"/>
                                            <TextBlock Text="{Binding SelectedRequest.CreatedAtUtc, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss} UTC'}" FontWeight="Bold" FontSize="12" HorizontalAlignment="Right"/>
                                        </DockPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>
        </DockPanel>
    </Grid>
</UserControl>
