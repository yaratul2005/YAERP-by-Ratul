<UserControl x:Class="YAERP.UI.Views.Security.UserAndRolesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:YAERP.UI.Controls"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1000">
    <Grid Background="#F8FAFC">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Control Toolbar -->
        <Border Grid.Row="0" Background="White" Padding="16" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Command="{Binding OpenCreateUserModalCommand}" Style="{DynamicResource PrimaryButtonStyle}" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <controls:SvgIcon Data="{StaticResource Svg.Plus}" Width="16" Height="16" Foreground="White" Margin="0,0,8,0"/>
                        <TextBlock Text="New User"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding OpenEditRoleModalCommand}" Style="{DynamicResource SecondaryButtonStyle}" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <controls:SvgIcon Data="{StaticResource Svg.Lock}" Width="16" Height="16" Foreground="#0F172A" Margin="0,0,8,0"/>
                        <TextBlock Text="New Role"/>
                    </StackPanel>
                </Button>
                <Button Style="{DynamicResource GhostButtonStyle}" Margin="0,0,8,0" ToolTip="Refresh Directory">
                    <controls:SvgIcon Data="{StaticResource Svg.Refresh}" Width="16" Height="16" Foreground="#64748B"/>
                </Button>
                <Button Style="{DynamicResource GhostButtonStyle}" ToolTip="Export Audit Log">
                    <controls:SvgIcon Data="{StaticResource Svg.Export}" Width="16" Height="16" Foreground="#64748B"/>
                </Button>
            </StackPanel>
        </Border>

        <!-- Sub-Tab Layout -->
        <TabControl Grid.Row="1" Margin="16" Background="Transparent" BorderThickness="0">
            <!-- User Directory -->
            <TabItem Header="User Directory">
                <DataGrid ItemsSource="{Binding Users}" AutoGenerateColumns="False" CanUserAddRows="False" Background="White" RowHeight="48">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Full Name" Binding="{Binding FullName}" Width="200"/>
                        <DataGridTextColumn Header="Username" Binding="{Binding Username}" Width="150"/>
                        <DataGridTextColumn Header="Department" Binding="{Binding Department}" Width="150"/>
                        <DataGridTemplateColumn Header="Status" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding IsActive, Converter={StaticResource StatusToColorConverter}}" CornerRadius="12" Padding="8,4" HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding IsActive}" Foreground="White" FontSize="11"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Actions" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Command="{Binding DataContext.ResetPasswordCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding Id}" Content="Reset Pwd" Style="{DynamicResource GhostButtonStyle}" Margin="0,0,8,0"/>
                                        <Button Command="{Binding DataContext.ToggleUserStatusCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding .}" Content="Toggle Status" Style="{DynamicResource GhostButtonStyle}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <!-- Permission Matrix Editor -->
            <TabItem Header="Permission Matrix">
                <Grid Background="White">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="250"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <ListBox Grid.Column="0" ItemsSource="{Binding Roles}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedRole}" BorderThickness="0,0,1,0" BorderBrush="#E2E8F0"/>

                    <!-- Interactive Checkbox Tree grouped by Module -->
                    <TreeView Grid.Column="1" ItemsSource="{Binding PermissionTree}" Margin="16" BorderThickness="0">
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,4">
                                    <CheckBox IsChecked="{Binding IsGranted}" Content="{Binding Name}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Code}" Foreground="#94A3B8" Margin="8,0,0,0" FontSize="11" VerticalAlignment="Center"/>
                                </StackPanel>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </Grid>
            </TabItem>

            <!-- Security Audit Logs -->
            <TabItem Header="Audit Logs">
                <DataGrid ItemsSource="{Binding AuditLogs}" AutoGenerateColumns="False" CanUserAddRows="False" Background="White">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Severity}" Value="High">
                                    <Setter Property="Background" Value="#FEF2F2"/> <!-- Crimson Tint -->
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Severity}" Value="Medium">
                                    <Setter Property="Background" Value="#FFFBEB"/> <!-- Amber Tint -->
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Timestamp" Binding="{Binding TimestampUtc}" Width="150"/>
                        <DataGridTextColumn Header="Event Type" Binding="{Binding EventType}" Width="150"/>
                        <DataGridTextColumn Header="Severity" Binding="{Binding Severity}" Width="100"/>
                        <DataGridTextColumn Header="Details" Binding="{Binding Details}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
