<UserControl x:Class="YAERP.UI.Views.SalesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BackgroundCanvasBrush}">
    <Grid Margin="10">
        <DockPanel>
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,20">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Left">
                        <TextBlock Text="Sales Orders &amp; CRM" FontSize="26" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock Text="Customer orders, quotations, and fulfillment pipeline" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                    <Button Content="🛒  Load Sales Orders" Command="{Binding LoadSalesOrdersCommand}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </DockPanel>
            </StackPanel>

            <Border Style="{StaticResource ModernCard}" Padding="0">
                <DataGrid ItemsSource="{Binding SalesOrders}" Style="{StaticResource ModernDataGrid}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Order Number" Binding="{Binding OrderNumber}" Width="150"/>
                        <DataGridTextColumn Header="Customer Name" Binding="{Binding CustomerName}" Width="*"/>
                        <DataGridTextColumn Header="Total Amount ($)" Binding="{Binding TotalAmount, StringFormat='{}{0:C2}'}" Width="160"/>
                        <DataGridTemplateColumn Header="Fulfillment Status" Width="160">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="#FEF3C7" CornerRadius="12" Padding="10,4" HorizontalAlignment="Left">
                                        <TextBlock Text="● Pending Draft" Foreground="#B45309" FontSize="11" FontWeight="Bold"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </DockPanel>
    </Grid>
</UserControl>
