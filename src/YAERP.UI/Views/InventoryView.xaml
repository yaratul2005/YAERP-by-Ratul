<UserControl x:Class="YAERP.UI.Views.InventoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BackgroundCanvasBrush}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
    </UserControl.Resources>
    
    <Grid Margin="10">
        <DockPanel>
            <!-- Header Toolbar -->
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,20">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Left">
                        <TextBlock Text="Inventory &amp; Warehouse Control" FontSize="26" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock Text="SKU management, stock tracking, and AI demand forecast analytics" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Content="📦  Load Products" Command="{Binding LoadProductsCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,10,0"/>
                        <Button Content="📊  Export Excel" Command="{Binding ExportToExcelCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0"/>
                        <Button Content="🚀  Export Google Sheets" Command="{Binding ExportToGoogleSheetsCommand}" Style="{StaticResource PrimaryButton}"/>
                    </StackPanel>
                </DockPanel>

                <!-- Search & Filters Toolbar -->
                <Border Style="{StaticResource ModernCard}" Padding="14" Margin="0,16,0,0">
                    <DockPanel>
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                            <TextBlock Text="🔍  Filter SKUs:" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="SemiBold" Margin="0,0,10,0"/>
                            <TextBox Text="{Binding SearchTerm, UpdateSourceTrigger=PropertyChanged}" Width="260" Padding="10,6" Background="#F1F5F9" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock Text="Warehouse:" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,8,0"/>
                            <ComboBox SelectedIndex="0" Width="160" Padding="8,6">
                                <ComboBoxItem Content="All Warehouses"/>
                                <ComboBoxItem Content="Main Warehouse"/>
                                <ComboBoxItem Content="West Coast Hub"/>
                            </ComboBox>
                        </StackPanel>
                    </DockPanel>
                </Border>
            </StackPanel>

            <!-- Main Layout: Table + AI Panel -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="340"/>
                </Grid.ColumnDefinitions>

                <!-- Data Table -->
                <Border Style="{StaticResource ModernCard}" Grid.Column="0" Margin="0,0,14,0" Padding="0">
                    <DataGrid ItemsSource="{Binding Products}" SelectedItem="{Binding SelectedProduct, Mode=TwoWay}" Style="{StaticResource ModernDataGrid}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="SKU Code" Binding="{Binding SKU}" Width="110"/>
                            <DataGridTextColumn Header="Product Name" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="List Price ($)" Binding="{Binding Price, StringFormat='{}{0:C2}'}" Width="110"/>
                            <DataGridTextColumn Header="Stock Quantity" Binding="{Binding Stock, StringFormat='{}{0:N0}'}" Width="110"/>
                            <DataGridTemplateColumn Header="Stock Status" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="#DCFCE7" CornerRadius="12" Padding="8,3" HorizontalAlignment="Left">
                                            <TextBlock Text="● In Stock" Foreground="#15803D" FontSize="11" FontWeight="Bold"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="AI Action" Width="130">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="⚡ Analyze AI" Command="{Binding DataContext.LoadProductForecastCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                Padding="8,4" FontSize="11" FontWeight="SemiBold" Background="#EFF6FF" Foreground="#1D4ED8" BorderThickness="0" Cursor="Hand"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <!-- AI Demand Insights Side Panel -->
                <Border Style="{StaticResource ModernCard}" Grid.Column="1" Padding="18">
                    <StackPanel>
                        <!-- Panel Header -->
                        <DockPanel Margin="0,0,0,14">
                            <StackPanel DockPanel.Dock="Left">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🤖  AI Demand Insights" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                </StackPanel>
                                <TextBlock Text="ML.NET Singular Spectrum Analysis" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <Button Content="🔄" Command="{Binding LoadProductForecastCommand}" HorizontalAlignment="Right" Background="Transparent" BorderThickness="0" ToolTip="Re-run ML Forecast" Cursor="Hand"/>
                        </DockPanel>

                        <Separator Background="{StaticResource BorderSubtleBrush}" Margin="0,0,0,16"/>

                        <!-- Selected Product Summary -->
                        <StackPanel Margin="0,0,0,14">
                            <TextBlock Text="Selected SKU" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding SelectedProduct.Name, FallbackValue='No Product Selected'}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2,0,0"/>
                            <TextBlock Text="{Binding SelectedProduct.SKU, StringFormat='SKU: {0}', FallbackValue='Select an item from table'}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                        </StackPanel>

                        <!-- AI Velocity Status Badge -->
                        <Border Background="#F8FAFC" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Consumption Velocity" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                                <Border CornerRadius="12" Padding="10,5" HorizontalAlignment="Left">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#DCFCE7"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasStockoutRisk}" Value="True">
                                                    <Setter Property="Background" Value="#FEE2E2"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding AiRiskStatusText}" FontSize="12" FontWeight="Bold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#15803D"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasStockoutRisk}" Value="True">
                                                        <Setter Property="Foreground" Value="#B91C1C"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Forecast Metric Callout -->
                        <Border Background="#EFF6FF" CornerRadius="8" Padding="14" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Projected 30-Day Demand" FontSize="12" FontWeight="SemiBold" Foreground="#1E40AF"/>
                                <TextBlock Text="{Binding PredictedDemand30Days, StringFormat='{}{0:N0} Units'}" FontSize="24" FontWeight="Bold" Foreground="#1E3A8A" Margin="0,4,0,0"/>
                                <TextBlock Text="Confidence Band: 95% SSA Time-Series" FontSize="10" Foreground="#3B82F6" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Stockout Risk Warning Callout -->
                        <Border Background="#FEF2F2" BorderBrush="#FCA5A5" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,16"
                                Visibility="{Binding HasStockoutRisk, Converter={StaticResource BoolToVisConverter}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚠️ " FontSize="14" VerticalAlignment="Top" Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding StockoutWarningMessage}" TextWrapping="Wrap" FontSize="11" FontWeight="SemiBold" Foreground="#991B1B"/>
                            </StackPanel>
                        </Border>

                        <!-- Mini Daily Forecast Projection Bar Sparkline -->
                        <StackPanel>
                            <TextBlock Text="30-Day Demand Projection Curve" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                            <Grid Height="40" Background="#F1F5F9">
                                <Polyline Points="0,35 25,30 50,32 75,25 100,28 125,20 150,22 175,15 200,18 225,10 250,12 280,5"
                                          Stroke="#2563EB" StrokeThickness="2" StrokeLineJoin="Round"/>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </DockPanel>
    </Grid>
</UserControl>
