<UserControl x:Class="YAERP.UI.Views.Modals.GoogleDrivePickerModal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:controls="clr-namespace:YAERP.UI.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="500" d:DesignWidth="650"
             Width="650" Height="500" Background="White">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="📁 Select Google Drive Destination Folder" FontSize="18" FontWeight="Bold" Foreground="#0F172A"/>
                <TextBlock Text="Choose or create an app-folder restricted to YAERP Cloud Exports" FontSize="12" Foreground="#64748B"/>
            </StackPanel>
        </DockPanel>

        <!-- Breadcrumb Navigation -->
        <Border Grid.Row="1" Background="#F1F5F9" CornerRadius="6" Padding="10,6" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Location: " FontSize="12" FontWeight="Bold" Foreground="#475569"/>
                <TextBlock Text="{Binding CurrentFolderPath}" FontSize="12" FontWeight="SemiBold" Foreground="#2563EB"/>
            </StackPanel>
        </Border>

        <!-- Folder List -->
        <Border Grid.Row="2" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Margin="0,0,0,12">
            <ListBox ItemsSource="{Binding Folders}" SelectedItem="{Binding SelectedFolder}" BorderThickness="0">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="8,6" Margin="0,2">
                            <DockPanel>
                                <TextBlock Text="📁" FontSize="16" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="13" Foreground="#0F172A"/>
                                    <TextBlock Text="{Binding CreatedTime, StringFormat='Created: {0}'}" FontSize="11" Foreground="#94A3B8"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <!-- Create New Subfolder Bar -->
        <Grid Grid.Row="3" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" Text="{Binding NewFolderName, UpdateSourceTrigger=PropertyChanged}" Padding="8" FontSize="12" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1"/>
            <Button Grid.Column="2" Command="{Binding CreateFolderCommand}" Content="+ Create Subfolder" Padding="12,6" Background="#10B981" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
        </Grid>

        <!-- Action Footer -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Command="{Binding CancelCommand}" Content="Cancel" Padding="14,8" Background="#F1F5F9" Foreground="#475569" FontWeight="Bold" BorderThickness="0" Margin="0,0,8,0" Cursor="Hand"/>
            <Button Command="{Binding ConfirmSelectionCommand}" Content="Select Destination Folder" Padding="16,8" Background="#2563EB" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
        </StackPanel>
    </Grid>
</UserControl>
