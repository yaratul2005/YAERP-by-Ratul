<UserControl x:Class="YAERP.UI.Views.Modals.Customer360Modal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:controls="clr-namespace:YAERP.UI.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="560"
             Background="#FFFFFF">

    <StackPanel Margin="8">
        <!-- Banner Header -->
        <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,16">
            <DockPanel>
                <controls:SvgIcon Data="{StaticResource Svg.Sales}" Width="24" Height="24" Foreground="#2563EB" DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <StackPanel>
                    <TextBlock Text="{Binding CustomerName, StringFormat='Customer 360° Profile: {0}'}" FontSize="16" FontWeight="Bold" Foreground="#1E3A8A"/>
                    <TextBlock Text="Credit line governance, order history ledger &amp; activity timeline" FontSize="12" Foreground="#3B82F6"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Credit Meter Box -->
        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,16">
            <StackPanel>
                <DockPanel Margin="0,0,0,4">
                    <TextBlock Text="Credit Line vs AR Exposure" FontSize="12" FontWeight="Bold" Foreground="#475569"/>
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                        <TextBlock Text="{Binding OutstandingArBalance, StringFormat='AR: {0:C0}'}" FontSize="12" FontWeight="Bold" Foreground="#DC2626" Margin="0,0,10,0"/>
                        <TextBlock Text="{Binding CreditLimit, StringFormat='Limit: {0:C0}'}" FontSize="12" FontWeight="Bold" Foreground="#059669"/>
                    </StackPanel>
                </DockPanel>

                <ProgressBar Value="{Binding CreditUsagePercent, Mode=OneWay}" Minimum="0" Maximum="100" Height="10" Margin="0,4,0,6"/>

                <DockPanel>
                    <TextBlock Text="{Binding CreditUsagePercent, StringFormat='{}{0:F1}% Used'}" FontSize="11" Foreground="#64748B" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding AvailableCreditLine, StringFormat='Available Credit: {0:C0}'}" FontSize="11" Foreground="#059669" FontWeight="Bold" HorizontalAlignment="Right"/>
                </DockPanel>
            </StackPanel>
        </Border>

        <!-- Customer Master Fields -->
        <UniformGrid Columns="2" Margin="0,0,0,12">
            <StackPanel Margin="0,0,6,0">
                <TextBlock Text="Customer Name:" FontSize="12" FontWeight="Bold" Foreground="#475569" Margin="0,0,0,4"/>
                <TextBox Text="{Binding CustomerName, UpdateSourceTrigger=PropertyChanged}" Height="34" Padding="6,4"/>
            </StackPanel>

            <StackPanel Margin="6,0,0,0">
                <TextBlock Text="Tax ID / Registration:" FontSize="12" FontWeight="Bold" Foreground="#475569" Margin="0,0,0,4"/>
                <TextBox Text="{Binding TaxId, UpdateSourceTrigger=PropertyChanged}" Height="34" Padding="6,4"/>
            </StackPanel>
        </UniformGrid>

        <UniformGrid Columns="2" Margin="0,0,0,12">
            <StackPanel Margin="0,0,6,0">
                <TextBlock Text="Email Contact:" FontSize="12" FontWeight="Bold" Foreground="#475569" Margin="0,0,0,4"/>
                <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" Height="34" Padding="6,4"/>
            </StackPanel>

            <StackPanel Margin="6,0,0,0">
                <TextBlock Text="Credit Limit ($):" FontSize="12" FontWeight="Bold" Foreground="#475569" Margin="0,0,0,4"/>
                <TextBox Text="{Binding CreditLimit, UpdateSourceTrigger=PropertyChanged}" Height="34" Padding="6,4"/>
            </StackPanel>
        </UniformGrid>

        <!-- Tabbed Order History & Log -->
        <TabControl Height="150" Margin="0,0,0,20" Background="White" BorderBrush="#E2E8F0">
            <TabItem Header="📦 Order History">
                <DataGrid ItemsSource="{Binding OrderHistory}" AutoGenerateColumns="False" CanUserAddRows="False" GridLinesVisibility="Horizontal" BorderThickness="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Order #" Binding="{Binding OrderNumber}" Width="120" FontWeight="Bold"/>
                        <DataGridTextColumn Header="Date" Binding="{Binding OrderDate, StringFormat=d}" Width="120"/>
                        <DataGridTextColumn Header="Total Amount" Binding="{Binding TotalAmount, StringFormat=C}" Width="140"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding PaymentStatus}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem Header="💬 Activity Log">
                <DataGrid ItemsSource="{Binding ActivityLogs}" AutoGenerateColumns="False" CanUserAddRows="False" GridLinesVisibility="Horizontal" BorderThickness="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Timestamp" Binding="{Binding Timestamp, StringFormat=g}" Width="140"/>
                        <DataGridTextColumn Header="Author" Binding="{Binding Author}" Width="120" FontWeight="SemiBold"/>
                        <DataGridTextColumn Header="Note / Action" Binding="{Binding ActionSummary}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>

        <!-- Action Bar -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Command="{Binding CancelCommand}" Content="Close" Height="38" Background="#F1F5F9" Foreground="#475569" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
            
            <Button Grid.Column="2" Command="{Binding SaveCustomerDetailsCommand}" Height="38" Background="#2563EB" Foreground="#FFFFFF" FontWeight="Bold" BorderThickness="0" Cursor="Hand">
                <StackPanel Orientation="Horizontal">
                    <controls:SvgIcon Data="{StaticResource Svg.Check}" Width="16" Height="16" Foreground="#FFFFFF" Margin="0,0,6,0"/>
                    <TextBlock Text="Save Customer Profile" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>
    </StackPanel>
</UserControl>
