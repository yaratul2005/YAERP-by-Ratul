<UserControl x:Class="YAERP.UI.Views.Modals.JournalEntryModal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:controls="clr-namespace:YAERP.UI.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="680"
             Background="#FFFFFF">

    <StackPanel Margin="8">
        <!-- Header Banner -->
        <Border Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,14">
            <DockPanel>
                <controls:SvgIcon Data="{StaticResource Svg.Finance}" Width="24" Height="24" Foreground="#16A34A" DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <StackPanel>
                    <TextBlock Text="{Binding ReferenceNumber, StringFormat='General Ledger Journal Entry: #{0}'}" FontSize="16" FontWeight="Bold" Foreground="#14532D"/>
                    <TextBlock Text="Real-time debit vs credit balance validation &amp; audit trail creation" FontSize="12" Foreground="#15803D"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Unbalanced Alert Banner -->
        <Border Background="#FEF2F2" BorderBrush="#FCA5A5" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,12"
                Visibility="{Binding IsUnbalanced, Converter={StaticResource BoolToVis}}">
            <StackPanel Orientation="Horizontal">
                <controls:SvgIcon Data="{StaticResource Svg.Lock}" Width="16" Height="16" Foreground="#DC2626" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock Text="{Binding UnbalancedDifference, StringFormat='⚠️ Unbalanced Entry! Debits and Credits differ by {0:C2}'}" Foreground="#991B1B" FontSize="12" FontWeight="Bold"/>
            </StackPanel>
        </Border>

        <!-- Status Message Banner -->
        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,0,12"
                Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisConverter}}">
            <TextBlock Text="{Binding StatusMessage}" Foreground="#2563EB" FontSize="12" FontWeight="SemiBold"/>
        </Border>

        <!-- Form Top Header -->
        <UniformGrid Columns="2" Margin="0,0,0,12">
            <StackPanel Margin="0,0,6,0">
                <TextBlock Text="Journal Voucher Ref:" FontSize="12" FontWeight="Bold" Foreground="#475569" Margin="0,0,0,4"/>
                <TextBox Text="{Binding ReferenceNumber, UpdateSourceTrigger=PropertyChanged}" Height="34" Padding="6,4"/>
            </StackPanel>

            <StackPanel Margin="6,0,0,0">
                <TextBlock Text="Journal Description / Memo:" FontSize="12" FontWeight="Bold" Foreground="#475569" Margin="0,0,0,4"/>
                <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" Height="34" Padding="6,4"/>
            </StackPanel>
        </UniformGrid>

        <!-- Journal Lines Grid Toolbar -->
        <DockPanel Margin="0,0,0,6">
            <TextBlock Text="Debit &amp; Credit Voucher Lines:" FontSize="13" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
            <Button Command="{Binding AddLineCommand}" DockPanel.Dock="Right" Content="+ Add Account Line" Padding="10,4" Background="#10B981" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
        </DockPanel>

        <!-- Journal Lines DataGrid -->
        <DataGrid ItemsSource="{Binding JournalLines}" AutoGenerateColumns="False" CanUserAddRows="False" Height="180" Margin="0,0,0,14" GridLinesVisibility="Horizontal" BorderBrush="#E2E8F0">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Account Code &amp; Title" Binding="{Binding AccountName, UpdateSourceTrigger=PropertyChanged}" Width="200" FontWeight="Bold"/>
                <DataGridTextColumn Header="Line Description" Binding="{Binding Description, UpdateSourceTrigger=PropertyChanged}" Width="180"/>
                <DataGridTextColumn Header="Debit ($)" Binding="{Binding Debit, UpdateSourceTrigger=PropertyChanged, StringFormat=F2}" Width="100"/>
                <DataGridTextColumn Header="Credit ($)" Binding="{Binding Credit, UpdateSourceTrigger=PropertyChanged, StringFormat=F2}" Width="100"/>

                <DataGridTemplateColumn Header="Actions" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Command="{Binding DataContext.RemoveLineCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Content="✕" Background="Transparent" Foreground="#DC2626" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Balance Totals Footer -->
        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Total Debits:" Foreground="#64748B" FontSize="12"/>
                    <TextBlock Text="{Binding TotalDebit, StringFormat=C2}" FontWeight="Bold" FontSize="15" Foreground="#059669"/>
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <TextBlock Text="Total Credits:" Foreground="#64748B" FontSize="12"/>
                    <TextBlock Text="{Binding TotalCredit, StringFormat=C2}" FontWeight="Bold" FontSize="15" Foreground="#2563EB"/>
                </StackPanel>

                <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                    <TextBlock Text="Status:" Foreground="#64748B" FontSize="12"/>
                    <Border Background="#D1FAE5" Visibility="{Binding IsBalanced, Converter={StaticResource BoolToVis}}" CornerRadius="4" Padding="8,2">
                        <TextBlock Text="✓ Balanced" FontWeight="Bold" Foreground="#065F46" FontSize="12"/>
                    </Border>
                    <Border Background="#FEF2F2" Visibility="{Binding IsUnbalanced, Converter={StaticResource BoolToVis}}" CornerRadius="4" Padding="8,2">
                        <TextBlock Text="❌ Unbalanced" FontWeight="Bold" Foreground="#991B1B" FontSize="12"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Action Bar -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Command="{Binding CancelCommand}" Content="Cancel" Height="40" Background="#F1F5F9" Foreground="#475569" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
            
            <Button Grid.Column="2" Command="{Binding PostJournalCommand}" IsEnabled="{Binding IsBalanced}" Height="40" Background="#2563EB" Foreground="#FFFFFF" FontWeight="Bold" BorderThickness="0" Cursor="Hand">
                <StackPanel Orientation="Horizontal">
                    <controls:SvgIcon Data="{StaticResource Svg.Check}" Width="16" Height="16" Foreground="#FFFFFF" Margin="0,0,6,0"/>
                    <TextBlock Text="Post Journal Entry" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>
    </StackPanel>
</UserControl>
