<UserControl x:Class="YAERP.UI.Views.Modals.BomEditorModal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:controls="clr-namespace:YAERP.UI.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="550" d:DesignWidth="680"
             Background="#FFFFFF">

    <StackPanel Margin="8">
        <!-- Header Banner -->
        <Border Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,14">
            <DockPanel>
                <controls:SvgIcon Data="{StaticResource Svg.Manufacturing}" Width="24" Height="24" Foreground="#16A34A" DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <StackPanel>
                    <TextBlock Text="Bill of Materials (BOM) Multi-Level Builder" FontSize="16" FontWeight="Bold" Foreground="#14532D"/>
                    <TextBlock Text="Component yield %, scrap factor rules &amp; DAG cycle detection validation" FontSize="12" Foreground="#15803D"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Status Message Banner -->
        <Border Background="#FEF2F2" BorderBrush="#FCA5A5" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,0,12"
                Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisConverter}}">
            <TextBlock Text="{Binding StatusMessage}" Foreground="#991B1B" FontSize="12" FontWeight="SemiBold"/>
        </Border>

        <!-- Assembly Form Header -->
        <UniformGrid Columns="2" Margin="0,0,0,12">
            <StackPanel Margin="0,0,6,0">
                <TextBlock Text="Assembly Name:" FontSize="12" FontWeight="Bold" Foreground="#475569" Margin="0,0,0,4"/>
                <TextBox Text="{Binding AssemblyName, UpdateSourceTrigger=PropertyChanged}" Height="34" Padding="6,4"/>
            </StackPanel>

            <StackPanel Margin="6,0,0,0">
                <TextBlock Text="Revision Code:" FontSize="12" FontWeight="Bold" Foreground="#475569" Margin="0,0,0,4"/>
                <TextBox Text="{Binding RevisionCode, UpdateSourceTrigger=PropertyChanged}" Height="34" Padding="6,4"/>
            </StackPanel>
        </UniformGrid>

        <!-- Components Grid Toolbar -->
        <DockPanel Margin="0,0,0,6">
            <TextBlock Text="Child Components &amp; Sub-Assemblies:" FontSize="13" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
            <Button Command="{Binding AddComponentCommand}" DockPanel.Dock="Right" Content="+ Add Component" Padding="10,4" Background="#10B981" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
        </DockPanel>

        <!-- Components DataGrid -->
        <DataGrid ItemsSource="{Binding ComponentLines}" AutoGenerateColumns="False" CanUserAddRows="False" Height="170" Margin="0,0,0,20" GridLinesVisibility="Horizontal" BorderBrush="#E2E8F0">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Component Name / SKU" Binding="{Binding ComponentName, UpdateSourceTrigger=PropertyChanged}" Width="220" FontWeight="Bold"/>
                <DataGridTextColumn Header="Qty / Unit" Binding="{Binding QuantityPerAssembly, UpdateSourceTrigger=PropertyChanged}" Width="90"/>
                <DataGridTextColumn Header="Yield %" Binding="{Binding YieldPercent, UpdateSourceTrigger=PropertyChanged, StringFormat=F1}" Width="90"/>
                <DataGridTextColumn Header="Scrap %" Binding="{Binding ScrapFactorPercent, UpdateSourceTrigger=PropertyChanged, StringFormat=F1}" Width="90"/>

                <DataGridTemplateColumn Header="Actions" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Command="{Binding DataContext.RemoveComponentCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Content="✕" Background="Transparent" Foreground="#DC2626" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Action Bar -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Command="{Binding CancelCommand}" Content="Cancel" Height="40" Background="#F1F5F9" Foreground="#475569" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
            
            <Button Grid.Column="2" Command="{Binding SaveBomCommand}" Height="40" Background="#2563EB" Foreground="#FFFFFF" FontWeight="Bold" BorderThickness="0" Cursor="Hand">
                <StackPanel Orientation="Horizontal">
                    <controls:SvgIcon Data="{StaticResource Svg.Check}" Width="16" Height="16" Foreground="#FFFFFF" Margin="0,0,6,0"/>
                    <TextBlock Text="Save Bill of Materials" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>
    </StackPanel>
</UserControl>
