<UserControl x:Class="YAERP.UI.Views.Modals.GoogleSheetsExportModal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="550" d:DesignWidth="650"
             Width="650" Height="550" Background="White">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,20">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="📊 Export DataGrid to Google Sheets" FontSize="20" FontWeight="Bold" Foreground="#0F172A"/>
                <TextBlock Text="Stream structured table records to Google Cloud with OAuth 2.0 privacy scoping" FontSize="13" Foreground="#64748B"/>
            </StackPanel>
        </DockPanel>

        <!-- Google Account Status Card -->
        <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,20">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <Border Width="36" Height="36" CornerRadius="18" Background="#DBEAFE" Margin="0,0,12,0">
                        <TextBlock Text="👤" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding UserInfo.Email, FallbackValue='Not Connected to Google Account'}" FontWeight="Bold" FontSize="13" Foreground="#0F172A"/>
                        <TextBlock Text="{Binding UserInfo.Name, FallbackValue='Click Connect to authenticate via OAuth 2.0 loopback'}" FontSize="11" Foreground="#64748B"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Command="{Binding ConnectAccountCommand}" Content="Connect Google Account" Padding="10,6" Background="#2563EB" Foreground="White" FontWeight="Bold" FontSize="11" BorderThickness="0" Cursor="Hand"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Main Settings Form -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Spreadsheet Title -->
                <TextBlock Text="Spreadsheet Title:" FontSize="12" FontWeight="Bold" Foreground="#475569" Margin="0,0,0,4"/>
                <TextBox Text="{Binding SpreadsheetTitle, UpdateSourceTrigger=PropertyChanged}" Padding="10" FontSize="13" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" Margin="0,0,0,16"/>

                <!-- Destination Folder -->
                <TextBlock Text="Target Google Drive Folder:" FontSize="12" FontWeight="Bold" Foreground="#475569" Margin="0,0,0,4"/>
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Text="{Binding SelectedFolderName}" IsReadOnly="True" Padding="10" FontSize="13" Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1"/>
                    <Button Grid.Column="2" Command="{Binding SelectDestinationFolderCommand}" Content="Browse Folders..." Padding="12,8" Background="#0F172A" Foreground="White" FontWeight="Bold" FontSize="12" BorderThickness="0" Cursor="Hand"/>
                </Grid>

                <Separator Background="#E2E8F0" Margin="0,0,0,16"/>

                <!-- Formatting Options -->
                <TextBlock Text="Formatting Options &amp; Layout" FontSize="14" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,12"/>

                <CheckBox IsChecked="{Binding FreezeHeader}" Content="Auto-Freeze Header Row (Row 1)" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,10"/>
                <CheckBox IsChecked="{Binding BoldHeaders}" Content="Apply Bold Formatting to Header Text" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,10"/>
                <CheckBox IsChecked="{Binding AlternatingShading}" Content="Apply Alternating Row Shading for Readability" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,16"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer Action Bar -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Command="{Binding CancelCommand}" Content="Cancel" Padding="14,8" Background="#F1F5F9" Foreground="#475569" FontWeight="Bold" BorderThickness="0" Margin="0,0,8,0" Cursor="Hand"/>
            <Button Command="{Binding ExportAndOpenCommand}" Content="🚀 Export &amp; Open in Google Sheets" Padding="16,8" Background="#059669" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
        </StackPanel>
    </Grid>
</UserControl>
