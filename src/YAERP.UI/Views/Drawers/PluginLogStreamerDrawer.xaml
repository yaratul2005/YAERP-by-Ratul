<UserControl x:Class="YAERP.UI.Views.Drawers.PluginLogStreamerDrawer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:controls="clr-namespace:YAERP.UI.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="550" d:DesignWidth="460"
             Background="#FFFFFF">

    <StackPanel Margin="16">
        <!-- Drawer Header Banner -->
        <Border Background="#F1F5F9" CornerRadius="8" Padding="14" Margin="0,0,0,16">
            <DockPanel>
                <controls:SvgIcon Data="{StaticResource Svg.Plugins}" Width="24" Height="24" Foreground="#2563EB" DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <StackPanel>
                    <TextBlock Text="{Binding PluginName}" FontSize="15" FontWeight="Bold" Foreground="#0F172A"/>
                    <TextBlock Text="{Binding PluginId, StringFormat='Assembly Sandbox: {0}'}" FontSize="11" Foreground="#64748B"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Version & Author Meta -->
        <UniformGrid Columns="2" Margin="0,0,0,16">
            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,4,0">
                <StackPanel>
                    <TextBlock Text="Version &amp; Author:" FontSize="11" Foreground="#64748B"/>
                    <TextBlock Text="{Binding Version, StringFormat='v{0}'}" FontWeight="Bold" Foreground="#0F172A"/>
                    <TextBlock Text="{Binding Author}" FontSize="11" Foreground="#334155"/>
                </StackPanel>
            </Border>

            <Border Background="#D1FAE5" BorderBrush="#86EFAC" BorderThickness="1" CornerRadius="6" Padding="10" Margin="4,0,0,0">
                <StackPanel>
                    <TextBlock Text="Sandbox Status:" FontSize="11" Foreground="#065F46"/>
                    <TextBlock Text="{Binding Status}" FontWeight="Bold" Foreground="#047857" FontSize="12"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Streamed Log Terminal View -->
        <TextBlock Text="Live Serilog Log Output Stream:" FontSize="12" FontWeight="Bold" Foreground="#475569" Margin="0,0,0,6"/>
        <DataGrid ItemsSource="{Binding StreamedLogs}" AutoGenerateColumns="False" CanUserAddRows="False" Height="260" Margin="0,0,0,20" GridLinesVisibility="Horizontal" BorderBrush="#E2E8F0">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Timestamp" Binding="{Binding Timestamp, StringFormat=T}" Width="90"/>
                <DataGridTextColumn Header="Level" Binding="{Binding Level}" Width="70" FontWeight="Bold"/>
                <DataGridTextColumn Header="Log Message" Binding="{Binding LogMessage}" Width="*" Foreground="#1E40AF"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Action Bar -->
        <Button Command="{Binding CloseCommand}" Content="Close Streamer" Height="40" Background="#F1F5F9" Foreground="#475569" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
    </StackPanel>
</UserControl>
