<UserControl x:Class="YAERP.UI.Views.Drawers.UserProfileDrawer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="300">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16">

            <TextBlock Text="Change Password" FontSize="16" FontWeight="Bold" Margin="0,0,0,12"/>

            <TextBlock Text="Current Password" Margin="0,0,0,4"/>
            <PasswordBox Margin="0,0,0,12" Padding="6"/>
            <!-- Note: PasswordBox doesn't support basic data binding to text in WPF securely out of the box without helpers, so using placeholder here -->

            <TextBlock Text="New Password" Margin="0,0,0,4"/>
            <PasswordBox Margin="0,0,0,12" Padding="6"/>

            <TextBlock Text="Confirm New Password" Margin="0,0,0,4"/>
            <PasswordBox Margin="0,0,0,12" Padding="6"/>

            <Button Command="{Binding ChangePasswordCommand}" Content="Update Password" Style="{DynamicResource SecondaryButtonStyle}" Margin="0,0,0,24"/>

            <Separator Margin="0,0,0,24"/>

            <TextBlock Text="Preferences" FontSize="16" FontWeight="Bold" Margin="0,0,0,12"/>

            <TextBlock Text="Theme" Margin="0,0,0,4"/>
            <ComboBox SelectedItem="{Binding SelectedTheme}" Margin="0,0,0,12" Padding="6">
                <ComboBoxItem Content="System"/>
                <ComboBoxItem Content="Light"/>
                <ComboBoxItem Content="Dark Slate"/>
                <ComboBoxItem Content="High Contrast"/>
            </ComboBox>

            <TextBlock Text="Startup Tab" Margin="0,0,0,4"/>
            <ComboBox SelectedItem="{Binding StartupTab}" Margin="0,0,0,12" Padding="6">
                <ComboBoxItem Content="Dashboard"/>
                <ComboBoxItem Content="Inventory"/>
                <ComboBoxItem Content="Sales"/>
                <ComboBoxItem Content="Finance"/>
            </ComboBox>

            <TextBlock Text="Grid Density" Margin="0,0,0,4"/>
            <ComboBox SelectedItem="{Binding GridDensity}" Margin="0,0,0,24" Padding="6">
                <ComboBoxItem Content="Comfortable"/>
                <ComboBoxItem Content="Compact"/>
            </ComboBox>

            <Button Command="{Binding SavePreferencesCommand}" Content="Save Preferences" Style="{DynamicResource PrimaryButtonStyle}"/>

        </StackPanel>
    </ScrollViewer>
</UserControl>
