<UserControl x:Class="YAERP.UI.Views.Drawers.ConflictResolverDrawer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="450">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Unresolved Sync Conflicts" FontWeight="Bold" FontSize="16" Margin="0,0,0,12"/>

        <ListBox Grid.Row="1" ItemsSource="{Binding Conflicts}" SelectedItem="{Binding SelectedConflict}" BorderThickness="1" BorderBrush="#E2E8F0" Margin="0,0,0,16">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="8">
                        <TextBlock Text="{Binding EntityType}" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding DetectedAt, StringFormat='{}{0:HH:mm:ss UTC}'}" Foreground="#64748B" FontSize="11"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="2">
            <TextBlock Text="Local State:" FontWeight="SemiBold"/>
            <TextBox Text="{Binding SelectedConflict.LocalPayload}" IsReadOnly="True" TextWrapping="Wrap" Margin="0,4,0,12" Padding="8" Background="#F1F5F9" MaxHeight="100"/>

            <TextBlock Text="Remote Cloud State:" FontWeight="SemiBold"/>
            <TextBox Text="{Binding SelectedConflict.RemotePayload}" IsReadOnly="True" TextWrapping="Wrap" Margin="0,4,0,16" Padding="8" Background="#FEF2F2" MaxHeight="100"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Command="{Binding KeepLocalVersionCommand}" Content="Keep Local" Style="{DynamicResource PrimaryButtonStyle}" Margin="0,0,8,0"/>
                <Button Command="{Binding AcceptCloudVersionCommand}" Content="Accept Cloud" Style="{DynamicResource DestructiveButtonStyle}"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
