<UserControl x:Class="YAERP.UI.Views.Drawers.ApprovalInspectorDrawer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:controls="clr-namespace:YAERP.UI.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="460"
             Background="#FFFFFF">

    <StackPanel Margin="16">
        <!-- Drawer Header Banner -->
        <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,16">
            <DockPanel>
                <controls:SvgIcon Data="{StaticResource Svg.Approval}" Width="24" Height="24" Foreground="#2563EB" DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <StackPanel>
                    <TextBlock Text="{Binding EntityId, StringFormat='Approval Inspector: #{0}'}" FontSize="16" FontWeight="Bold" Foreground="#1E3A8A"/>
                    <TextBlock Text="{Binding EntityType, StringFormat='Transaction Type: {0}'}" FontSize="12" Foreground="#3B82F6"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Amount & Tier Summary Box -->
        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Total Amount:" Foreground="#64748B" FontSize="12"/>
                    <TextBlock Text="{Binding TransactionAmount, StringFormat=C2}" FontWeight="Bold" FontSize="18" Foreground="#2563EB"/>
                </StackPanel>

                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                    <TextBlock Text="Required Approval Tier:" Foreground="#64748B" FontSize="12"/>
                    <Border Background="#FEF3C7" CornerRadius="4" Padding="8,2" Margin="0,2,0,0">
                        <TextBlock Text="{Binding CurrentTier}" FontWeight="Bold" Foreground="#B45309" FontSize="11"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Document Line Items Grid -->
        <TextBlock Text="Underlying Document Line Items:" FontSize="12" FontWeight="Bold" Foreground="#475569" Margin="0,0,0,6"/>
        <DataGrid ItemsSource="{Binding LineItems}" AutoGenerateColumns="False" CanUserAddRows="False" Height="130" Margin="0,0,0,16" GridLinesVisibility="Horizontal" BorderBrush="#E2E8F0">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Line Description" Binding="{Binding LineDescription}" Width="*" FontWeight="SemiBold"/>
                <DataGridTextColumn Header="Qty" Binding="{Binding Quantity}" Width="50"/>
                <DataGridTextColumn Header="Unit Price" Binding="{Binding UnitPrice, StringFormat=C}" Width="90"/>
                <DataGridTextColumn Header="Total" Binding="{Binding LineTotal, StringFormat=C}" Width="90" FontWeight="Bold"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Approval Timeline Log -->
        <TextBlock Text="Approval Audit History Log:" FontSize="12" FontWeight="Bold" Foreground="#475569" Margin="0,0,0,6"/>
        <DataGrid ItemsSource="{Binding AuditSteps}" AutoGenerateColumns="False" CanUserAddRows="False" Height="110" Margin="0,0,0,16" GridLinesVisibility="Horizontal" BorderBrush="#E2E8F0">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Timestamp" Binding="{Binding Timestamp, StringFormat=g}" Width="120"/>
                <DataGridTextColumn Header="Tier" Binding="{Binding TierLevel}" Width="100" FontWeight="Bold"/>
                <DataGridTextColumn Header="Action" Binding="{Binding Action}" Width="80" Foreground="#059669" FontWeight="Bold"/>
                <DataGridTextColumn Header="Comments" Binding="{Binding Comments}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Approver Comments Input -->
        <TextBlock Text="Approver Decision Comments:" FontSize="12" FontWeight="Bold" Foreground="#475569" Margin="0,0,0,4"/>
        <TextBox Text="{Binding DecisionComments, UpdateSourceTrigger=PropertyChanged}" Height="50" AcceptsReturn="True" Padding="6,4" Margin="0,0,0,16"/>

        <!-- Action Bar -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Command="{Binding CancelCommand}" Content="Cancel" Height="40" Background="#F1F5F9" Foreground="#475569" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
            
            <Button Grid.Column="2" Command="{Binding ApproveRequestCommand}" Height="40" Background="#10B981" Foreground="#FFFFFF" FontWeight="Bold" BorderThickness="0" Cursor="Hand">
                <StackPanel Orientation="Horizontal">
                    <controls:SvgIcon Data="{StaticResource Svg.Check}" Width="16" Height="16" Foreground="#FFFFFF" Margin="0,0,6,0"/>
                    <TextBlock Text="Approve Transaction" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>
    </StackPanel>
</UserControl>
