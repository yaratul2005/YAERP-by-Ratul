<Window x:Class="YAERP.UI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:YAERP.UI.ViewModels"
        xmlns:views="clr-namespace:YAERP.UI.Views"
        xmlns:viewsSec="clr-namespace:YAERP.UI.Views.Security"
        xmlns:vmSec="clr-namespace:YAERP.UI.ViewModels.Security"
        xmlns:anim="clr-namespace:YAERP.UI.Animations"
        xmlns:controls="clr-namespace:YAERP.UI.Views.Controls"
        xmlns:uiControls="clr-namespace:YAERP.UI.Controls"
        mc:Ignorable="d"
        Title="YAERP - Enterprise Resource Planning Suite" Height="768" Width="1366"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundCanvasBrush}">

    <Window.InputBindings>
        <KeyBinding Gesture="CTRL+K" Command="{Binding ToggleCommandPaletteCommand}"/>
        <KeyBinding Gesture="F1" Command="{Binding ToggleCommandPaletteCommand}"/>
    </Window.InputBindings>
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:InventoryViewModel}">
            <views:InventoryView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SalesViewModel}">
            <views:SalesView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:FinanceViewModel}">
            <views:FinanceView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PosViewModel}">
            <views:PosView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ApprovalCenterViewModel}">
            <views:ApprovalCenterView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PluginHubViewModel}">
            <views:PluginHubView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ManufacturingViewModel}">
            <views:ManufacturingView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:WarehouseManagementViewModel}">
            <views:WarehouseManagementView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DeepFinancialsViewModel}">
            <views:DeepFinancialsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmSec:UserAndRolesViewModel}">
            <viewsSec:UserAndRolesView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SystemSettingsViewModel}">
            <views:SystemSettingsView />
        </DataTemplate>

        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <controls:WorkspaceDataTemplateSelector x:Key="WorkspaceDataTemplateSelector">
            <controls:WorkspaceDataTemplateSelector.DashboardTemplate>
                <DataTemplate>
                    <views:DashboardView />
                </DataTemplate>
            </controls:WorkspaceDataTemplateSelector.DashboardTemplate>
            <controls:WorkspaceDataTemplateSelector.InventoryTemplate>
                <DataTemplate>
                    <views:InventoryView />
                </DataTemplate>
            </controls:WorkspaceDataTemplateSelector.InventoryTemplate>
            <controls:WorkspaceDataTemplateSelector.SalesTemplate>
                <DataTemplate>
                    <views:SalesView />
                </DataTemplate>
            </controls:WorkspaceDataTemplateSelector.SalesTemplate>
            <controls:WorkspaceDataTemplateSelector.FinanceTemplate>
                <DataTemplate>
                    <views:FinanceView />
                </DataTemplate>
            </controls:WorkspaceDataTemplateSelector.FinanceTemplate>
            <controls:WorkspaceDataTemplateSelector.PosTemplate>
                <DataTemplate>
                    <views:PosView />
                </DataTemplate>
            </controls:WorkspaceDataTemplateSelector.PosTemplate>
            <controls:WorkspaceDataTemplateSelector.ApprovalCenterTemplate>
                <DataTemplate>
                    <views:ApprovalCenterView />
                </DataTemplate>
            </controls:WorkspaceDataTemplateSelector.ApprovalCenterTemplate>
            <controls:WorkspaceDataTemplateSelector.PluginHubTemplate>
                <DataTemplate>
                    <views:PluginHubView />
                </DataTemplate>
            </controls:WorkspaceDataTemplateSelector.PluginHubTemplate>
            <controls:WorkspaceDataTemplateSelector.ManufacturingTemplate>
                <DataTemplate>
                    <views:ManufacturingView />
                </DataTemplate>
            </controls:WorkspaceDataTemplateSelector.ManufacturingTemplate>
            <controls:WorkspaceDataTemplateSelector.WarehouseManagementTemplate>
                <DataTemplate>
                    <views:WarehouseManagementView />
                </DataTemplate>
            </controls:WorkspaceDataTemplateSelector.WarehouseManagementTemplate>
            <controls:WorkspaceDataTemplateSelector.DeepFinancialsTemplate>
                <DataTemplate>
                    <views:DeepFinancialsView />
                </DataTemplate>
            </controls:WorkspaceDataTemplateSelector.DeepFinancialsTemplate>
            <controls:WorkspaceDataTemplateSelector.UserAndRolesTemplate>
                <DataTemplate>
                    <viewsSec:UserAndRolesView />
                </DataTemplate>
            </controls:WorkspaceDataTemplateSelector.UserAndRolesTemplate>
            <controls:WorkspaceDataTemplateSelector.SystemSettingsTemplate>
                <DataTemplate>
                    <views:SystemSettingsView />
                </DataTemplate>
            </controls:WorkspaceDataTemplateSelector.SystemSettingsTemplate>
        </controls:WorkspaceDataTemplateSelector>

    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar Navigation -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}">
            <DockPanel>
                <!-- Application Brand Header -->
                <StackPanel DockPanel.Dock="Top" Margin="24,28,24,32">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="36" Height="36" CornerRadius="8" Background="{StaticResource PrimaryBrush}" Margin="0,0,12,0">
                            <TextBlock Text="Y" Foreground="#FFFFFF" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="YAERP" Foreground="#F8FAFC" FontSize="20" FontWeight="Bold"/>
                            <TextBlock Text="Enterprise Suite" Foreground="#64748B" FontSize="11" FontWeight="SemiBold"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- Navigation Links -->
                <ScrollViewer DockPanel.Dock="Top" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <Button Content="📊  Dashboard" Command="{Binding NavigateDashboardCommand}" Style="{StaticResource SidebarNavButton}"/>
                        <Button Content="🏢  Warehouse &amp; WMS" Command="{Binding NavigateWarehouseManagementCommand}" Style="{StaticResource SidebarNavButton}"/>
                        <Button Content="📦  Inventory &amp; Stock" Command="{Binding NavigateInventoryCommand}" Style="{StaticResource SidebarNavButton}"/>
                        <Button Content="🛒  Sales &amp; CRM" Command="{Binding NavigateSalesCommand}" Style="{StaticResource SidebarNavButton}"/>
                        <Button Content="📈  Deep Financials" Command="{Binding NavigateDeepFinancialsCommand}" Style="{StaticResource SidebarNavButton}"/>
                        <Button Content="💰  Finance &amp; Ledger" Command="{Binding NavigateFinanceCommand}" Style="{StaticResource SidebarNavButton}"/>
                        <Button Content="🖥️  POS Terminal" Command="{Binding NavigatePosCommand}" Style="{StaticResource SidebarNavButton}"/>
                        <Button Content="🛡️  Approval Center" Command="{Binding NavigateApprovalCenterCommand}" Style="{StaticResource SidebarNavButton}"/>
                        <Button Content="🏭  Manufacturing" Command="{Binding NavigateManufacturingCommand}" Style="{StaticResource SidebarNavButton}"/>
                        <Button Content="🔐  Security &amp; Roles" Command="{Binding NavigateUserAndRolesCommand}" Style="{StaticResource SidebarNavButton}"/>
                        <Button Content="🧩  Plugin Hub" Command="{Binding NavigatePluginHubCommand}" Style="{StaticResource SidebarNavButton}"/>
                        <Button Content="⚙️  System Settings" Command="{Binding NavigateSystemSettingsCommand}" Style="{StaticResource SidebarNavButton}"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- Footer Status -->
                <Border DockPanel.Dock="Bottom" Margin="20" Padding="12" Background="#1E293B" CornerRadius="8">
                    <StackPanel>
                        <TextBlock Text="System Environment" Foreground="#64748B" FontSize="11" FontWeight="SemiBold"/>
                        <TextBlock Text="Production Ready (SQLite)" Foreground="#10B981" FontSize="12" FontWeight="Bold" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
            </DockPanel>
        </Border>

        <!-- Main Content Area -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="64"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Top Header Bar -->
            <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,0,1">
                <DockPanel Margin="24,0">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="YAERP Desktop Control Center" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="Bold" FontSize="15"/>
                    </StackPanel>

                    <!-- Top Right Status & Cloud Sync Bar -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <!-- Cloud Connectivity Pill Badge -->
                        <Border CornerRadius="12" Padding="10,4" Margin="0,0,10,0">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#DCFCE7"/>
                                    <Setter Property="BorderBrush" Value="#86EFAC"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCloudOnline}" Value="False">
                                            <Setter Property="Background" Value="#FEF3C7"/>
                                            <Setter Property="BorderBrush" Value="#FDE68A"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding SyncStatusBadgeText}" FontSize="12" FontWeight="Bold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#15803D"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCloudOnline}" Value="False">
                                                    <Setter Property="Foreground" Value="#B45309"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <!-- Pending Outbox Queue Count Chip (Click to resolve conflicts) -->
                        <Button Command="{Binding OpenConflictResolverCommand}" Background="#F1F5F9" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" Padding="10,4" Margin="0,0,10,0" Cursor="Hand" ToolTip="Open Sync Conflict Resolver">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📦 " FontSize="11" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding UnsyncedOutboxCount, StringFormat='{}{0} Outbox'}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>

                        <!-- Manual Sync Now Button -->
                        <Button Command="{Binding ManualSyncNowCommand}" Padding="10,5" Background="#2563EB" Foreground="#FFFFFF" FontWeight="Bold" FontSize="11" BorderThickness="0" Margin="0,0,16,0" Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Content" Value="🔄 Sync Now"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsManualSyncRunning}" Value="True">
                                            <Setter Property="Content" Value="⏳ Syncing..."/>
                                            <Setter Property="IsEnabled" Value="False"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <!-- User Profile Avatar Pill -->
                        <Button Command="{Binding OpenUserProfileDrawerCommand}" Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="Open User Profile &amp; Preferences">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="System Administrator" VerticalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" Margin="0,0,12,0"/>
                                <Border Width="36" Height="36" CornerRadius="18" Background="{StaticResource PrimaryBrush}">
                                    <TextBlock Text="SA" Foreground="#FFFFFF" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </DockPanel>
            </Border>


            <!-- Main Workspace Tabs -->
            <TabControl Grid.Row="2" ItemsSource="{Binding Workspace.OpenTabs}" SelectedItem="{Binding Workspace.ActiveTab}"
                        Background="Transparent" BorderThickness="0" Margin="24">
                <TabControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="4,2">
                            <TextBlock Text="{Binding IconKey}" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                            <TextBlock Text="*" Visibility="{Binding IsDirty, Converter={StaticResource BoolToVis}}" Foreground="#F59E0B" FontWeight="Bold" Margin="4,0,0,0"/>
                            <Button Content="✕" Command="{Binding CloseTabCommand}" Background="Transparent" BorderThickness="0" Margin="8,0,0,0" Foreground="#94A3B8" Cursor="Hand" ToolTip="Close Tab"/>
                        </StackPanel>
                    </DataTemplate>
                </TabControl.ItemTemplate>
                <TabControl.ContentTemplateSelector>
                    <StaticResource ResourceKey="WorkspaceDataTemplateSelector"/>
                </TabControl.ContentTemplateSelector>
            </TabControl>

        </Grid>


        <!-- Contextual Active Tab Slide-Out Drawer Host -->
        <uiControls:DrawerHost Grid.ColumnSpan="2" Panel.ZIndex="90"
                               IsOpen="{Binding Workspace.ActiveTab.IsDrawerOpen}"
                               Title="{Binding Workspace.ActiveTab.DrawerTitle}"
                               DrawerContent="{Binding Workspace.ActiveTab.DrawerContent}"
                               CloseCommand="{Binding Workspace.ActiveTab.CloseDrawerCommand}"/>

        <!-- Contextual Active Tab Modal Overlay Host -->
        <uiControls:ModalOverlayHost Grid.ColumnSpan="2" Panel.ZIndex="95"
                                     IsOpen="{Binding Workspace.ActiveTab.IsModalOpen}"
                                     Title="{Binding Workspace.ActiveTab.ModalTitle}"
                                     ModalContent="{Binding Workspace.ActiveTab.ModalContent}"
                                     CloseCommand="{Binding Workspace.ActiveTab.CloseModalCommand}"/>

        <!-- Command Palette Overlay -->
        <controls:CommandPaletteOverlay Grid.ColumnSpan="2" IsVisible="{Binding IsCommandPaletteOpen, Mode=TwoWay}" Panel.ZIndex="100"/>

        <!-- Application Level Modal Dialog Overlay Backdrop -->
        <Grid Grid.ColumnSpan="2" Visibility="{Binding IsModalOpen, Converter={StaticResource BoolToVis}}" Background="#800F172A" Panel.ZIndex="105">
            <Border Width="520" VerticalAlignment="Center" HorizontalAlignment="Center" 
                    Background="#FFFFFF" CornerRadius="12" Padding="24">
                <Border.Effect>
                    <DropShadowEffect Color="#0F172A" Direction="270" ShadowDepth="8" BlurRadius="24" Opacity="0.18"/>
                </Border.Effect>
                <StackPanel>
                    <DockPanel Margin="0,0,0,20">
                        <TextBlock Text="{Binding ModalTitle}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                        <Button Content="✕" Command="{Binding CloseModalCommand}" HorizontalAlignment="Right" 
                                Background="Transparent" Foreground="#64748B" FontSize="16" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
                    </DockPanel>
                    <ContentControl Content="{Binding CurrentModalContent}"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
